{
  "name": "gemini-cli-telegram",
  "version": "1.25.1",
  "description": "Connect Gemini CLI to Telegram",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qcsunny/gemini-cli-telegram.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gemini-cli-telegram": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc --build && mkdir -p dist/config && cp src/config/models.json dist/config/",
    "build:clean": "rm -rf dist tsconfig.tsbuildinfo && npm run build",
    "debug": "LOG_LEVEL=debug npm run build",
    "debug:run": "LOG_LEVEL=debug node dist/cli.js",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip --dependencies",
    "start": "node dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.1",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.45.1",
    "lru-cache": "^10.4.3",
    "markdown-it": "^14.1.1",
    "markdown-it-cjk-friendly": "^2.0.2",
    "pino": "^10.3.1",
    "undici": "^8.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@grammyjs/types": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "^9.39.5",
    "knip": "^5.88.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
